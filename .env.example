# Banco microservicio - entorno local (opcional)
# Copia este archivo a .env solo si necesitas personalizar valores.
# docker compose --profile apps up --build funciona sin .env gracias a los defaults.

# Imágenes / registry
IMAGE_REGISTRY=ghcr.io/jhoel-gavidia/banco-microservicio
IMAGE_TAG=local

# Puertos host
ACCOUNTS_DB_PORT=5432
KAFKA_PORT=9092
KEYCLOAK_PORT=8080
FLOCI_PORT=4566
ACCOUNT_SERVICE_PORT=8081
TRANSFER_SERVICE_PORT=8083
API_GATEWAY_PORT=8084

# PostgreSQL (infra local)
ACCOUNTS_DB_NAME=accounts_db
ACCOUNTS_DB_USER=accounts
ACCOUNTS_DB_PASSWORD=accounts
TRANSFERS_DB_NAME=transfers_db
TRANSFERS_DB_USER=transfers
TRANSFERS_DB_PASSWORD=transfers

# Keycloak (dev local)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Issuer esperado por los tokens emitidos desde host/realm
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/banco
KEYCLOAK_HOSTNAME=localhost

# S3 local / Floci (sin AWS real)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
RECEIPT_S3_BUCKET=banco-comprobantes-local
