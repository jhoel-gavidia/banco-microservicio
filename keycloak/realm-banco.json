{
  "realm": "banco",
  "enabled": true,
  "displayName": "Banco",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "account_read",
        "description": "Consultar cuentas y movimientos propios",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "account_write",
        "description": "Depositar y retirar en cuentas propias",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "transfer_read",
        "description": "Consultar transferencias propias",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "transfer_write",
        "description": "Crear transferencias propias",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "account_internal",
        "description": "Llamadas internas de transferencias a account-service",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "admin",
        "description": "Acceso total, solo para pruebas locales",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      }
    ]
  },
  "clientScopes": [
    {
      "name": "roles",
      "description": "OpenID Connect roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },    {
      "name": "transfer.read",
      "description": "Consultar transferencias propias",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "transfer.write",
      "description": "Crear transferencias propias",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    }
  ],
  "clients": [
    {
      "clientId": "account-service",
      "name": "account-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "account-service-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "fullScopeAllowed": true,
      "defaultClientScopes": ["roles"],
      "protocolMappers": [
        {
          "name": "customerId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "customerId",
            "claim.name": "customerId",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "transfer-service",
      "name": "transfer-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "transfer-service-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "fullScopeAllowed": true,
      "defaultClientScopes": ["roles"],
      "optionalClientScopes": ["address", "phone", "offline_access", "transfer.read", "transfer.write"],
      "protocolMappers": [
        {
          "name": "customerId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "customerId",
            "claim.name": "customerId",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    }
  ],
